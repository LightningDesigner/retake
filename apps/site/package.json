{
  "name": "retake-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "retake --port 3300 -- next dev",
    "build": "next build",
    "start": "next start --port 3301",
    "typecheck": "tsc --noEmit",
    "check:build": "tsc --noEmit && next build && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-build.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "retake-dev": "workspace:*",
    "typescript": "^7.0.2"
  }
}
