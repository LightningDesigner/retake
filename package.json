{
  "name": "retake-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=18" },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "test:engine": "pnpm --filter retake-dev test:engine",
    "test:shell": "pnpm --filter retake-dev test:shell",
    "dev:site": "pnpm --filter ./apps/site --if-present dev",
    "check:site": "pnpm --filter ./apps/site check:build"
  }
}
