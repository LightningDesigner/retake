{
  "name": "retake-dev",
  "version": "0.4.0",
  "description": "Retake: a time machine for your dev server (Vite apps, Next.js, React Router). Drag back on a timeline and your app is at that moment; branch a new take from there.",
  "type": "module",
  "main": "./src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "retake": "bin/retake.js",
    "retake-dev": "bin/retake.js"
  },
  "files": [
    "bin",
    "src",
    "!src/shell/mock",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-spring/web": "^10.1.2",
    "@vitejs/plugin-react": "^5.2.0",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.1"
  },
  "scripts": {
    "check": "node test/check-syntax.js",
    "test": "node test/check-syntax.js && playwright test",
    "test:engine": "playwright test --project=engine",
    "test:shell": "playwright test --project=shell"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "nextjs",
    "react-router",
    "time-travel",
    "prototype",
    "devtools",
    "replay"
  ],
  "license": "MIT"
}
